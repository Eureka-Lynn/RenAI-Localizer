              "occurrence_ids": [
                "bus_7f544b1f@game/scripts/_day_1/script.rpy:898:0"
              ],
              "source_texts": [
                "{i}The funeral of Pearlanne Scarlet— your cousin's mother and your aunt— seemed like something you shouldn't ignore, even considering your own late mother’s rocky relationship with this side of the family.{/i}"
              ],
              "source_refs": [
                {
                  "source_file": "game/scripts/_day_1/script.rpy",
