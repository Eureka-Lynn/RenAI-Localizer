{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RenAI Localizer semantic claim",
  "type": "object",
  "required": ["claim_id", "kind", "subject_id", "value", "source_refs", "confidence", "status", "verifier_reason", "unresolved_reason", "status_history"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["character", "scene", "fact", "term"]},
    "subject_id": {"type": "string", "minLength": 1},
    "value": {"type": "string"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["candidate", "verified", "rejected", "unresolved"]},
    "verifier_reason": {"type": "string"},
    "unresolved_reason": {"type": "string"},
    "status_history": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
